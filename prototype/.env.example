GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Local testing: ollama (unlimited local requests) or gemini (cloud benchmark).
VISION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:2b
OLLAMA_TIMEOUT_MS=120000
SERPAPI_API_KEY=
# auto: replay exact saved searches, otherwise run once and record. live: always call providers. replay: never call providers.
DISCOVERY_DATA_MODE=auto
DEVELOPER_DASHBOARD=false
# Public HTTPS URL pointing to this running server, required for Lens image retrieval.
PUBLIC_BASE_URL=https://sculptor-sliding-headlamp.ngrok-free.dev
# Shared preview cap: analyze/search operations per server hour (each may use multiple provider calls).
DISCOVERY_HOURLY_LIMIT=20
